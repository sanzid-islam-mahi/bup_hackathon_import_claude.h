# LLM provider for operator-note interpretation.
# Set OPENAI_API_KEY (primary) OR GROQ_API_KEY (free-tier fallback chain) — one is required.
OPENAI_API_KEY=
GROQ_API_KEY=
GEMINI_API_KEY=

# Server
PORT=8000
HOST=0.0.0.0

# Optional: caps POST /optimize-energy requests per IP per 60s. 0/unset = disabled.
RATE_LIMIT_PER_MIN=0

# Optional: path to the organizer-provided samples.json for local test scripts,
# if not placed directly in the repo root.
SAMPLES_JSON_PATH=
